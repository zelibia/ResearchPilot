# 复制为 .env 后填写。.env 不进版本库。

# LLM（C3 / BYOK）。**留空即可**：用户在界面上「用户设置 → AI 模型」里
# 填自己的 Key 就能用，不需要改这个文件。
# 这里填的属于"服务端配置"（自托管单用户场景），会被界面明确标注来源；
# 用户在会话里连接过之后，一律只用他本会话的密钥。
# 密钥只进内存：不写数据库、不写日志、不进版本库。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# 可选：模型清单以服务商官方文档为准，升级时改这里即可
#   DeepSeek 常用：deepseek-flash（默认）、deepseek-v4-pro

# 外部文献 API（T05）
# 填上邮箱会进入对方的"礼貌池"，限流更宽。不填也能用，走公共池。
OPENALEX_MAILTO=
CROSSREF_MAILTO=

# 外部请求的工程参数（可选，都有默认值）
HTTP_TIMEOUT=30              # 单次请求超时（秒）
HTTP_MAX_RETRIES=2           # 失败重试次数，总尝试次数 = 重试 + 1
HTTP_MIN_INTERVAL=0.5        # 两次请求之间的最小间隔（秒）
HTTP_CACHE_TTL_DAYS=7        # 缓存有效期（天），过期后仍可在断网时兜底

# 测试数据库位置（自检脚本会自己设成临时库；手动测试时可指定）
# RESEARCHPILOT_DB=/tmp/rp_test.db

# 数据路径（只读引用既有科研工作区）
RAW_SAC_DIR=/home/wannnlee/seismic/sac_data
LEGACY_PROJECT_DIR=/home/wannnlee/seismic/ambient_noise_test
